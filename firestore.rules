rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function noteData(ownerId, noteId) {
      return get(/databases/$(database)/documents/users/$(ownerId)/notes/$(noteId)).data;
    }

    // A note whose selfDestructAt has passed is only waiting to be deleted
    // (by the owner's app or the scheduled expire job); collaborators lose
    // access at once rather than when the deletion happens.
    function notExpired(data) {
      return data.get('selfDestructAt', null) == null
        || data.selfDestructAt > request.time;
    }

    function isCollaborator(data) {
      return signedIn() && data.get('collaborators', []).hasAny([request.auth.uid]);
    }

    function canAccessNote(ownerId, noteId) {
      return isUser(ownerId)
        || (isCollaborator(noteData(ownerId, noteId))
            && notExpired(noteData(ownerId, noteId)));
    }

    function optional(data, field, type) {
      return !(field in data) || data[field] == null
        || (type == 'string' && data[field] is string)
        || (type == 'bool' && data[field] is bool)
        || (type == 'int' && data[field] is int)
        || (type == 'number' && data[field] is number)
        || (type == 'timestamp' && data[field] is timestamp)
        || (type == 'list' && data[field] is list)
        || (type == 'map' && data[field] is map);
    }

    // Every field a note document may hold. Plaintext title/content/metadata
    // and the old PIN verifier are deliberately absent: the server refuses to
    // store them, so a buggy or old client cannot leak note contents.
    function validNote(data, ownerId) {
      return data.keys().hasOnly([
          'colorIndex', 'isPinned', 'isArchived', 'isLocked', 'isStudyMaterial',
          'selfDestructAt', 'selfDestructOnRead', 'createdAt', 'updatedAt',
          'encryptedTitle', 'encryptedContent', 'encryptedMeta', 'encryptionVersion',
          'wrappedKey', 'pinWrappedKey', 'pinSalt', 'keyGen', 'keyHistory',
          'collaborators', 'encryptedKeys', 'sharedBy', 'sharedAt',
          'versionCounter', 'lastVersionAt',
          'studyDueAt', 'studyInterval', 'studyEaseFactor', 'studyRepetitions',
          'deletedAt'])
        && optional(data, 'colorIndex', 'int')
        && optional(data, 'isPinned', 'bool')
        && optional(data, 'isArchived', 'bool')
        && optional(data, 'isLocked', 'bool')
        && optional(data, 'isStudyMaterial', 'bool')
        && optional(data, 'selfDestructOnRead', 'bool')
        && optional(data, 'selfDestructAt', 'timestamp')
        && optional(data, 'createdAt', 'timestamp')
        && optional(data, 'updatedAt', 'timestamp')
        && optional(data, 'deletedAt', 'timestamp')
        && optional(data, 'encryptedTitle', 'string')
        && optional(data, 'encryptedContent', 'string')
        && optional(data, 'encryptedMeta', 'string')
        && optional(data, 'encryptionVersion', 'int')
        && optional(data, 'keyGen', 'int')
        && optional(data, 'collaborators', 'list')
        && data.get('collaborators', []).size() <= 50
        && optional(data, 'encryptedKeys', 'map')
        && data.get('encryptedKeys', {}).size() <= 50
        && data.get('sharedBy', ownerId) in [ownerId, null];
    }

    // User profile (public key, display name). Readable one document at a
    // time by uid; never listable, so the user base cannot be enumerated.
    match /users/{userId} {
      allow get: if signedIn();
      allow list: if false;
      // Deleting the account removes the profile (a delete has no
      // request.resource, so it needs its own rule).
      allow delete: if isUser(userId);
      allow create, update: if isUser(userId)
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'publicKey'])
        && optional(request.resource.data, 'email', 'string')
        && optional(request.resource.data, 'displayName', 'string')
        && request.resource.data.get('displayName', '').size() <= 200
        && optional(request.resource.data, 'publicKey', 'string');
    }

    // Owner-only private data (key backup, settings, ...). Notes are handled
    // separately below so that their stricter sub-rules are not overridden.
    match /users/{userId}/{collection}/{document=**} {
      allow read, write: if isUser(userId) && collection != 'notes';
    }

    // Notes: owner has full access, collaborators may read.
    match /users/{ownerId}/notes/{noteId} {
      allow get: if isUser(ownerId)
        || (isCollaborator(resource.data) && notExpired(resource.data));
      // Queries cannot be limited by expiry in rules (the feed query has no
      // selfDestructAt filter), so the app hides expired notes from lists.
      allow list: if isUser(ownerId) || isCollaborator(resource.data);
      allow create, update: if isUser(ownerId) && validNote(request.resource.data, ownerId);
      allow delete: if isUser(ownerId);

      // Version history is owner-only.
      match /versions/{versionId} {
        allow read, write: if isUser(ownerId);
      }

      // Comments: anyone with access may read and post as themselves.
      // Comments are immutable; the author or the note owner may delete.
      match /comments/{commentId} {
        allow read: if canAccessNote(ownerId, noteId);
        allow create: if canAccessNote(ownerId, noteId)
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.keys().hasOnly(
               ['authorUid', 'authorName', 'encryptedContent', 'keyGen', 'createdAt'])
          && optional(request.resource.data, 'authorName', 'string')
          && request.resource.data.get('authorName', '').size() <= 200
          && request.resource.data.encryptedContent is string
          && request.resource.data.encryptedContent.size() <= 100000;
        allow update: if false;
        allow delete: if signedIn()
          && (resource.data.authorUid == request.auth.uid || isUser(ownerId));
      }
    }

    // Collection group: shared notes appear in a collaborator's feed. Only
    // `list`: this also matches single-note gets, which must go through the
    // expiry check above.
    match /{path=**}/notes/{noteId} {
      allow list: if signedIn()
        && resource.data.collaborators.hasAny([request.auth.uid]);
    }

    // Exact-match email -> uid lookup used for "share by email". Readable only
    // by document id (the lowercased email); never listable. A user may only
    // claim the entry for the verified email on their own auth token.
    match /emailIndex/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && email == request.auth.token.email.lower()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Moderation reports: reporters and note owners can read; only creation
    // is allowed (resolution is handled by support, not self-serve).
    match /reports/{reportId} {
      // A report must be about a real comment, on a note the reporter can
      // read, by the author it names. Otherwise anyone could file "reports"
      // naming any user as the target, and that user would see them.
      function reportsRealComment(data) {
        return canAccessNote(data.targetOwnerUid, data.noteId)
          && get(/databases/$(database)/documents/users/$(data.targetOwnerUid)/notes/$(data.noteId)/comments/$(data.commentId))
               .data.authorUid == data.commentAuthorUid;
      }

      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && reportsRealComment(request.resource.data)
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly([
             'reporterUid', 'targetOwnerUid', 'noteId', 'commentId',
             'commentAuthorUid', 'reason', 'status', 'createdAt'])
        && optional(request.resource.data, 'reason', 'string')
        && request.resource.data.get('reason', '').size() <= 2000;
      allow read: if signedIn()
        && (request.auth.uid == resource.data.reporterUid
            || request.auth.uid == resource.data.targetOwnerUid);
      allow update, delete: if false;
    }

    // Share links: fetchable by anyone who holds the (unguessable) token,
    // never listable. The link carries no note content or title.
    match /shareLinks/{token} {
      function link() {
        return get(/databases/$(database)/documents/shareLinks/$(token)).data;
      }

      allow get: if signedIn();
      // Owners may query their own links (e.g. to clean up on note delete).
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.mode in ['open', 'approval']
        && request.resource.data.keys().hasOnly(['ownerUid', 'noteId', 'mode', 'createdAt'])
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/notes/$(request.resource.data.noteId));
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.noteId == resource.data.noteId
        && request.resource.data.mode in ['open', 'approval'];
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /requests/{recipientUid} {
        allow get: if signedIn()
          && (request.auth.uid == recipientUid
              || request.auth.uid == resource.data.ownerUid);

        // A recipient files their own request. It may only start out
        // approved when the link is in 'open' mode; approval-mode links
        // always start pending and only the owner can approve.
        allow create: if isUser(recipientUid)
          && request.resource.data.ownerUid == link().ownerUid
          && request.resource.data.noteId == link().noteId
          && request.resource.data.recipientUid == recipientUid
          && (request.resource.data.status == 'pending'
              || (request.resource.data.status == 'approved' && link().mode == 'open'))
          && request.resource.data.keys().hasOnly([
               'ownerUid', 'noteId', 'recipientUid', 'recipientName',
               'recipientEmail', 'recipientPublicKey', 'status', 'createdAt']);

        // Owner may only move the status forward (and record who approved).
        // Recipient may only refresh their own profile fields.
        allow update: if signedIn()
          && ((request.auth.uid == resource.data.ownerUid
               && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['status', 'approvedBy'])
               && request.resource.data.status in ['approved', 'shared']
               && request.resource.data.get('approvedBy', request.auth.uid) == request.auth.uid)
              || (request.auth.uid == recipientUid
               && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['recipientName', 'recipientEmail', 'recipientPublicKey'])));

        allow delete: if signedIn()
          && (request.auth.uid == resource.data.ownerUid
              || request.auth.uid == recipientUid);
      }
    }

    // Collection group: owner watches join requests across their links, and
    // a recipient finds their own requests (to delete them with the account).
    match /{path=**}/requests/{recipientUid} {
      allow read: if signedIn()
        && (resource.data.ownerUid == request.auth.uid
            || resource.data.recipientUid == request.auth.uid);
    }

    // Collection group: an author finds the comments they posted on other
    // people's notes, to delete them with the account. Comments are still
    // only readable through the note (canAccessNote) otherwise.
    match /{path=**}/comments/{commentId} {
      allow list: if signedIn() && resource.data.authorUid == request.auth.uid;
    }
  }
}
